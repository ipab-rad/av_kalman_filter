<launch>
  <arg name="rviz_config" default="$(find-pkg-share av_kalman_filter)/rviz/global_ekf.rviz"/>
  <group>
    <push-ros-namespace namespace="/localisation"/>

    <node pkg="av_kalman_filter" exec="twist_msg_converter" name="vehicle_twist_converter">
      <param name="linear_vel_std" value="0.1"/>
      <param name="angluar_vel_std" value="0.15"/>
      <param name="use_sim_time" value="true"/>
      <remap from="twist_in" to="/vehicle/twist"/>
      <remap from="twist_out" to="/vehicle/twist_with_covariance"/>
    </node>

    <node pkg="robot_localization" exec="navsat_transform_node" name="navsat_transform">
      <param from="$(find-pkg-share av_kalman_filter)/config/navsat_param.yaml"/>
      <param name="debug" value="true"/>
      <param name="use_sim_time" value="true"/>

      <!-- Input -->
      <remap from="gps/fix" to="/sensor/gps/nav_sat_fix"/>
      <remap from="odometry/filtered" to="ekf_global/odometry"/>
      <remap from="imu" to="/sensor/imu/rear/data"/>
      <!-- Output -->
      <!-- sensor_msgs/NavSatFix-->
      <remap from="gps/filtered" to="gps/filtered"/>
      <!-- nav_msgs/Odometry -->
      <remap from="odometry/gps" to="odometry/gps"/>
    </node>

    <node pkg="robot_localization" exec="ekf_node" name="ekf_global">
      <param from="$(find-pkg-share av_kalman_filter)/config/global_ekf_param.yaml"/>
      <param name="debug" value="false"/>
      <param name="use_sim_time" value="true"/>
      <remap from="odometry/filtered" to="ekf_global/odometry"/>
    </node>

    <node pkg="robot_localization" exec="ekf_node" name="ekf_local">
      <param from="$(find-pkg-share av_kalman_filter)/config/local_ekf_param.yaml"/>
      <param name="debug" value="false"/>
      <param name="use_sim_time" value="true"/>
      <remap from="odometry/filtered" to="ekf_local/odometry"/>
    </node>

    <node pkg="rviz2" exec="rviz2" name="rviz_ekf" args="-d $(var rviz_config)">
      <param name="use_sim_time" value="true"/>
    </node>
  </group>
</launch>
